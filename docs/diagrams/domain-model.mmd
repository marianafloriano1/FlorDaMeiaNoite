  CUSTOMER {
    uuid id PK
    string full_name
    string email
    string cpf_encrypted
    string mobile
    boolean email_verified
    boolean mobile_verified
  }
  EMPLOYEE {
    uuid id PK
    string name
    string cpf_encrypted
    string email
    string contract_object_key
  }
  PRODUCT {
    uuid id PK
    string name_pt
    string category
    int stock_on_hand
    decimal price_brl
    boolean active
  }
  ORDER {
    uuid id PK
    uuid customer_id FK
    string status
    datetime created_at
    datetime reservation_expires_at
    datetime paid_at
  }
  ORDER_ITEM {
    uuid id PK
    uuid order_id FK
    uuid product_id FK
    int quantity
    decimal unit_price_brl
    int consumed_quantity
  }
  INVENTORY_LEDGER_ENTRY {
    uuid id PK
    uuid product_id FK
    uuid actor_id FK
    int delta
    string reason
    datetime created_at
  }
