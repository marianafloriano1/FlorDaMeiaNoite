# Supabase CLI local values; obtain actual local keys from `npm run supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Private employee contracts. The bucket itself is created by the local SQL migration.
EMPLOYEE_CONTRACT_MAX_BYTES=10485760

# TASK-006: use only synthetic values in development/tests; official store values are supplied before deployment.
WHATSAPP_STORE_NUMBER=+15555550199
ORDER_CANCELLATION_POLICY_TEXT=

# TASK-010 transactional email worker; leave unset until provider/domain configuration is provisioned.
NOTIFICATION_WORKER_POLL_INTERVAL_MS=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=
NOTIFICATION_SMTP_SECURE=
NOTIFICATION_SMTP_REQUIRE_TLS=
NOTIFICATION_SMTP_ALLOW_ANONYMOUS_TLS=
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_ALLOW_INSECURE_LOCAL=
NOTIFICATION_FROM_ADDRESS=
NOTIFICATION_FROM_NAME=
