{
  "name": "flor-da-meia-noite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin-supabase.ts",
    "test:auth": "node --import=tsx --test tests/auth/task003.test.ts",
    "test:catalog": "node --experimental-test-module-mocks --import=tsx --test tests/catalog/*.test.ts tests/translation/*.test.ts",
    "test:task007": "node --conditions=react-server --experimental-test-module-mocks --import=tsx --import=./tests/task007/next-test-setup.mjs --test tests/task007/*.test.ts",
    "test:task008": "node --experimental-test-module-mocks --import=tsx --test tests/task008/*.test.ts",
    "test:task005": "node --import=tsx --test tests/task005/*.test.ts",
    "test:task006": "node --import=tsx --test tests/task006/*.test.ts",
    "worker:reservation-expiration": "node src/workers/reservation-expiration.mjs",
    "worker:catalog-stock-alerts": "node src/workers/catalog-stock-alerts.mjs",
    "test:auth:supabase-mfa": "node --import=tsx --test tests/auth/task003.supabase-mfa.test.ts",
    "lint": "biome check src tests/auth tests/catalog tests/translation next.config.ts",
    "lint:task007": "biome check src/app/admin/catalog src/app/api/admin/catalog src/lib/catalog/admin-authorization.ts src/lib/catalog/admin-service.ts src/lib/catalog/admin-validation.ts src/lib/catalog/authorization.ts src/lib/storage/catalog-image-validation.ts src/lib/storage/catalog-products.ts src/workers/catalog-stock-alerts.mjs tests/task007 package.json",
    "lint:task008": "biome check src/app/admin/coupons src/app/api/admin/coupons src/app/cart/page.tsx src/app/api/orders/quote/route.ts src/app/api/orders/route.ts src/lib/coupons src/lib/orders/types.ts src/lib/orders/validation.ts tests/task008 package.json",
    "format": "biome format --write src next.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "supabase": "^2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
